{
	"name": "sidebar-login",
	"title": "Sidebar Login",
	"homepage": "https://wordpress.org/plugins/sidebar-login/",
	"description": "Easily add an ajax-enhanced login widget to the sidebar of your WordPress site.",
	"author": "Mike Jolley",
	"license": "GPL-3.0-or-later",
	"version": "3.0.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikejolley/sidebar-login.git"
	},
	"bugs": {
		"url": "https://github.com/mikejolley/sidebar-login/issues"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/scripts": "^36.0.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js assets/js tests/e2e",
		"lint:css": "wp-scripts lint-style \"assets/**/*.scss\"",
		"lint:php": "composer run-script phpcs",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"wp-env": "wp-env",
		"test:php": "wp-env run cli --env-cwd=wp-content/plugins/sidebar-login env WORDPRESS_TABLE_PREFIX=wptests_ vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js"
	}
}
